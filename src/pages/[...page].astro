---
import type { GetStaticPaths, Page } from "astro";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts, url, type DbEntry, type Post } from "../lib/draftbase";

// Emits `/` for page 1 and `/2`, `/3`, ... for the rest.
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	const posts = await getPosts();
	return paginate(posts, { pageSize: 5 });
};

const { page } = Astro.props as { page: Page<DbEntry<Post>> };
---

<Base
	title={page.currentPage === 1 ? "The Draftbase Example Blog" : `Page ${page.currentPage}`}
	description="A statically generated blog powered by Draftbase."
>
	{page.data.map((post) => <PostCard post={post} />)}

	{
		page.data.length === 0 && (
			<p class="muted">
				No published posts yet. Run <code>npm run seed</code>.
			</p>
		)
	}

	<nav class="pagination">
		{page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span />}
		{page.url.next ? <a href={page.url.next}>Older →</a> : <span />}
	</nav>

	<p class="muted" style="margin-top:2rem">
		<a href={url("rss.xml")}>Subscribe via RSS</a>
	</p>
</Base>
