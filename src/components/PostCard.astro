---
import { formatDate, url, type DbEntry, type Post } from "../lib/draftbase";

interface Props {
	post: DbEntry<Post>;
}

const { post } = Astro.props;
const author = post.fields.author?.fields;
const date = post.fields.publishedDate ?? post.publishedAt;
---

<li>
	<article class="card">
		{
			post.tags.length > 0 && (
				<a class="tagline" href={url(`tags/${post.tags[0]}`)}>
					{post.tags[0]}
				</a>
			)
		}
		<h2><a href={url(`posts/${post.fields.slug}`)}>{post.fields.title}</a></h2>
		<p>{post.fields.excerpt}</p>
		<div class="byline">
			{author?.avatar?.url && <img src={author.avatar.url} alt={author.name} loading="lazy" />}
			{author && <a href={url(`authors/${author.slug}`)}>{author.name}</a>}
			{date && <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>}
		</div>
	</article>
</li>
