# Delivery-scoped API key — read-only, published entries only.
# Used at BUILD time only (Node), never shipped to the browser.
# Never rename this to PUBLIC_DRAFTBASE_API_KEY: Astro inlines PUBLIC_* vars into the client bundle.
DRAFTBASE_API_KEY=

# Management-scoped key — ONLY needed to run `npm run seed` locally.
# Do not add this to CI or any hosting provider. It can write and delete your content.
DRAFTBASE_MANAGEMENT_API_KEY=

# Optional overrides
# DRAFTBASE_API_URL=https://api.draftbase.co
# DRAFTBASE_ENVIRONMENT=production
